# All values are repository-relative paths. No AWS credentials belong here.
UBIKE_MODEL_PATH=model/lgbm_full.txt
UBIKE_FREEZE_PATH=config/final_policy_freeze_before_may.json
UBIKE_PROTOCOL_PATH=config/protocol_frozen_before_june.json
UBIKE_INPUT_PATH=data/source/dynamic_red_empty_2026_06.parquet
UBIKE_API_INPUT_PATH=data/source/dynamic_red_empty_2026_06_input.parquet
UBIKE_REFERENCE_PATH=data/reference/june_all_eligible_decisions.parquet
UBIKE_STATIONS_PATH=data/stations/dim_station.csv
UBIKE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional AWS runtime settings. Leave bucket names empty for the local demo.
UBIKE_RUNTIME_BUCKET=
UBIKE_TRUTH_BUCKET=
UBIKE_RELEASE_ID=frozen-v1
UBIKE_S3_TIMEOUT_SECONDS=8

# Bedrock is downstream from LightGBM/SHAP and is disabled locally by default.
BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=
BEDROCK_REGION=
BEDROCK_TIMEOUT_SECONDS=6
BEDROCK_MAX_TOKENS=300
